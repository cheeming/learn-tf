#!/bin/bash
set -euo pipefail
umask 077
# Proxy service asset revision: ${SS_REVISION}

exec > >(tee -a /var/log/init.log) 2>&1

echo "init.sh --- START"

export DEBIAN_FRONTEND=noninteractive

# REMOVE SSH (Ubuntu 24.04 can use socket activation)
for UNIT in ssh.socket ssh.service; do
    if systemctl cat "$UNIT" >/dev/null 2>&1; then
        systemctl disable --now "$UNIT"
    fi
done
apt-get purge -y openssh-server
systemctl mask ssh.service ssh.socket

# INSTALL DEPENDENCIES
apt-get update
apt remove -y unattended-upgrades
apt install -y --no-install-recommends unzip nftables

# DO NOT UPGRADE FOR NOW, TAKES TOO LONG
#apt upgrade -y --no-install-recommends

# COMMENTED: Not stable
#snap install aws-cli --classic
curl "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o "awscliv2.zip"
unzip awscliv2.zip
./aws/install

# keep ssm for now, to debug
snap remove amazon-ssm-agent

# COPY FILES FROM S3
cd /home/ubuntu/
FILES=(%{ for SS_FILE in SS_FILES ~} "${SS_FILE}" %{ endfor ~})
for FILE in "$${FILES[@]}"; do
    mkdir -p "$(dirname "$FILE")"
    aws s3 cp "s3://cheems-vpn-configs/$${FILE}" "$${FILE}"
done

# ISOLATED PROXY SERVICES
for ACCOUNT in ss-backend ss-plugin; do
    if ! id "$ACCOUNT" >/dev/null 2>&1; then
        useradd --system --user-group --no-create-home --shell /usr/sbin/nologin "$ACCOUNT"
    fi
done
install -d -m 0755 /usr/local/libexec /etc/shadowsocks
install -m 0755 shadowsocks2-linux-arm64 /usr/local/libexec/shadowsocks2
install -m 0755 v2ray-plugin_linux_arm64 /usr/local/libexec/v2ray-plugin
install -m 0600 backend.env /etc/shadowsocks/backend.env
install -m 0600 plugin.env /etc/shadowsocks/plugin.env
install -d -m 0750 -o root -g ss-plugin "$(dirname '${CERT_FILE}')" "$(dirname '${KEY_FILE}')"
install -m 0640 -o root -g ss-plugin tmpsc.net/tmpsc_net.cer '${CERT_FILE}'
install -m 0640 -o root -g ss-plugin tmpsc.net/tmpsc_net.key '${KEY_FILE}'
# Service copies now live outside the ubuntu home; remove downloaded secrets.
rm -f backend.env plugin.env tmpsc.net/tmpsc_net.cer tmpsc.net/tmpsc_net.key
install -m 0600 shadowsocks-egress.nft /etc/shadowsocks/egress.nft
for UNIT in shadowsocks-firewall shadowsocks-backend shadowsocks-plugin; do
    install -m 0644 "$UNIT.service" /etc/systemd/system/
done

# Fail closed if the DNS exception would not match this image's resolver.
test -s /run/systemd/resolve/stub-resolv.conf
grep -Eq '^nameserver[[:space:]]+127\.0\.0\.53$' /etc/resolv.conf
systemctl daemon-reload
systemctl enable shadowsocks-firewall.service shadowsocks-backend.service shadowsocks-plugin.service
systemctl start shadowsocks-firewall.service
systemctl start shadowsocks-backend.service shadowsocks-plugin.service

# UPDATE THE PERMISSIONS FOR BINARIES
BINARIES=(%{ for SS_BINARY in SS_BINARIES ~} "${SS_BINARY}" %{ endfor ~})
for FILE in "$${BINARIES[@]}"; do
    chmod 0700 "$${FILE}"
done

# INSTALL NOIP binary
#apt install -y /home/ubuntu/noip-duc_3.3.0_arm64.deb

# UPDATE CONFIGS
install -m 0644 /home/ubuntu/limits.conf /etc/security/limits.conf

install -m 0644 /home/ubuntu/sysctl.conf /etc/sysctl.conf
sysctl -p /etc/sysctl.conf

# ADD CRONTAB

# update Dynamic DNS
#(crontab -l 2>/dev/null || true; echo "@reboot /home/ubuntu/update-ddns") | crontab -

# shutdown server to save costs
(crontab -l 2>/dev/null || true; echo "0 16 * * * shutdown -h now") | crontab -

echo "init.sh --- DONE (reboot after this)"

# restart machine to test crontab
reboot
